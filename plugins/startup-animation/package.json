{
  "name": "@chengmeng/dsh-startup-animation",
  "version": "0.1.0",
  "private": true,
  "description": "Chengmeng 启动动画：光穿过玻璃。覆盖层只做视觉，检查项由真实信号驱动，可跳过，尊重减少动态效果，不阻塞 DSH 初始化。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "license": "MIT"
}
