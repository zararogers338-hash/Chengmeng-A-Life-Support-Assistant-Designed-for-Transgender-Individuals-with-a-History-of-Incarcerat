{
  "name": "@chengmeng/dsh-pastel-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Chengmeng 的可选 Pastel 外观：桌面端折光壁纸加上粉白蓝的 token 覆盖层。只改外观，不触及 Agent、会话和记忆。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.2-0 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "license": "MIT"
}
